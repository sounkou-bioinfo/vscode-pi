{
  "name": "vscode-pi",
  "displayName": "Pi TUI Companion",
  "description": "Bridge the local clipboard and microphone into Pi running in a VS Code terminal, including WSL, Remote-SSH, and Dev Containers.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "publisher": "sounkou-bioinfo",
  "repository": {
    "type": "git",
    "url": "https://github.com/sounkou-bioinfo/vscode-pi.git"
  },
  "homepage": "https://github.com/sounkou-bioinfo/vscode-pi#readme",
  "bugs": {
    "url": "https://github.com/sounkou-bioinfo/vscode-pi/issues"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pi",
    "coding-agent",
    "terminal",
    "dictation",
    "clipboard",
    "remote-ssh",
    "wsl"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onCommand:vscodePi.pasteImageIntoTerminal",
    "onCommand:vscodePi.toggleDictation",
    "onCommand:vscodePi.selectMicrophone",
    "onCommand:vscodePi.configureDictationModel"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Remote image transfer requires a filesystem-backed remote folder."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "vscodePi.pasteImageIntoTerminal",
        "title": "Pi: Paste Clipboard Image into Terminal",
        "icon": "$(file-media)"
      },
      {
        "command": "vscodePi.toggleDictation",
        "title": "Pi: Start/Stop Dictation",
        "icon": "$(mic)"
      },
      {
        "command": "vscodePi.selectMicrophone",
        "title": "Pi: Select Dictation Microphone"
      },
      {
        "command": "vscodePi.configureDictationModel",
        "title": "Pi: Configure Dictation Model"
      }
    ],
    "keybindings": [
      {
        "command": "vscodePi.pasteImageIntoTerminal",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "terminalFocus"
      },
      {
        "command": "vscodePi.toggleDictation",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z",
        "when": "terminalFocus"
      }
    ],
    "menus": {
      "terminal/context": [
        {
          "command": "vscodePi.pasteImageIntoTerminal",
          "group": "navigation@10"
        },
        {
          "command": "vscodePi.toggleDictation",
          "group": "navigation@11"
        }
      ]
    },
    "configuration": {
      "title": "Pi TUI Companion",
      "properties": {
        "vscodePi.dictation.modelPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Local path to a transcribe.cpp GGUF model. Leave empty to reuse local pi-transcribe settings or choose/download a model on first use."
        },
        "vscodePi.dictation.language": {
          "type": "string",
          "default": "en",
          "scope": "window",
          "description": "Language code passed to the local transcription model. Use an empty value for model-driven language detection."
        },
        "vscodePi.dictation.microphone": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Exact local microphone name. Leave empty for the system default, or run Pi: Select Dictation Microphone."
        },
        "vscodePi.dictation.microphoneOccurrence": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "multipleOf": 1,
          "scope": "window",
          "description": "Zero-based occurrence used when multiple local microphones have the same name."
        },
        "vscodePi.dictation.maxRecordingSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "maximum": 1800,
          "scope": "window",
          "description": "Maximum duration of one local dictation recording."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check-types": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "render:readme": "node scripts/render-readme.mjs",
    "check:readme": "node scripts/render-readme.mjs --check",
    "check": "npm run check-types && npm test && npm run check:readme && npm run compile",
    "vscode:prepublish": "npm run check",
    "vsce:package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@picovoice/pvrecorder-node": "1.2.9",
    "transcribe-cpp": "0.1.3"
  },
  "devDependencies": {
    "@earendil-works/pi-transcribe": "https://github.com/earendil-works/pi-transcribe/archive/45924bd491e5ee2655d4269aa504eab11e27a424.tar.gz",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.109.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
